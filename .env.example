# API key production dari dashboard Biteship (jangan isi key asli di file ini)
BITESHIP_API_KEY=biteship_live.production_key_anda

# Credential production dari DOKU Dashboard > Integrations > API Keys
DOKU_CLIENT_ID=client_id_production_anda
DOKU_SECRET_KEY=secret_key_production_anda
BINDERBYTE_API_KEY=api_key_binderbyte_anda

# Hanya diperlukan selama fitur pembayaran ulang lama masih memakai Midtrans
MIDTRANS_SERVER_KEY=server_key_midtrans_anda
MIDTRANS_CLIENT_KEY=client_key_midtrans_anda
MIDTRANS_IS_PRODUCTION=False

# Domain publik aplikasi tanpa garis miring di akhir
PUBLIC_BASE_URL=https://laflyderm.lightermediagroup.com

# Django dan PostgreSQL untuk Docker
DJANGO_SECRET_KEY=ganti_dengan_secret_key_yang_kuat
DJANGO_DEBUG=False
DJANGO_SERVE_MEDIA=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,laflyderm.lightermediagroup.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://laflyderm.lightermediagroup.com
POSTGRES_DB=commerce_lfd
POSTGRES_USER=commerce
POSTGRES_PASSWORD=ganti_dengan_password_database_yang_kuat
POSTGRES_HOST=nama_container_postgresql
POSTGRES_PORT=5432
DOCKER_NETWORK=nama_network_postgresql
